! === 高载能负荷精细化调度机理模型 (minlp.apm) ===

! ---------------------------------------------------
! 1. 整数变量声明 (必须放在最前，供主程序识别)
! ---------------------------------------------------
Variables
  ! 碳化硅厂：4个档位的选择状态 (0-1变量)
  z_g1[1:24] >= 0, <= 1
  z_g2[1:24] >= 0, <= 1
  z_g3[1:24] >= 0, <= 1
  z_g4[1:24] >= 0, <= 1

  ! 钢铁厂：批次启动状态与加工状态 (0-1变量)
  z_start[1:24] >= 0, <= 1
  z_work[1:24] >= 0, <= 1
End Variables

! ---------------------------------------------------
! 2. 物理与系统参数设定
! ---------------------------------------------------
Parameters
  ! -- 电解铝厂热力学参数 --
  T_env = 25       ! 环境温度 (℃)
  C_cell = 1200    ! 电解槽等效热容 (MJ/℃)
  R_th = 0.08      ! 等效热阻 (℃/MW)
  eta_Al = 0.92    ! 电热转换效率
  
  ! -- 碳化硅厂档位与爬坡参数 --
  P_gear1 = 0      ! 0档位功率 (MW)
  P_gear2 = 60     ! 1档位功率 (MW)
  P_gear3 = 80     ! 2档位功率 (MW)
  P_gear4 = 100    ! 3档位功率 (MW)
  Ramp_max = 30    ! 最大安全爬坡速率 (MW/h)

  ! -- 钢铁厂参数 --
  P_steel_base= 50 ! 单炉加工功率 (MW)

  ! -- 系统环境参数 (为简化展示，设为常数。实际可接入风光出力曲线) --
  P_wt = 200       ! 风电出力预测
  P_pv = 100       ! 光伏出力预测
  Load_base = 300  ! 系统常规基础负荷
  Price_buy = 50   ! 主网购电单价 ($/MW)
End Parameters

! ---------------------------------------------------
! 3. 连续变量声明 (物理状态与功率)
! ---------------------------------------------------
Variables
  ! 电解铝厂：槽温与输入功率
  T_cell[1:25] = 955, >= 940, <= 970  ! 槽温严格限制在 940~970℃ 的安全域内
  P_Al[1:24] >= 0, <= 120

  ! 碳化硅厂：实际运行功率
  P_Si[1:24] >= 0, <= 100

  ! 钢铁厂：实际运行功率
  P_Steel[1:24] >= 0, <= 50

  ! 系统微网：向主网的购电量
  P_buy[1:24] >= 0
End Variables

! ---------------------------------------------------
! 4. 中间变量 (用于累加与简化目标函数)
! ---------------------------------------------------
Intermediates
  ! APM中累加求和的规范写法：利用一阶差分数组累加24小时的购电成本
  cost[0] = 0
  cost[1:24] = cost[0:23] + Price_buy * P_buy[1:24]
  Total_Cost = cost[24]
End Intermediates

! ---------------------------------------------------
! 5. 约束方程与目标函数
! ---------------------------------------------------
Equations
  ! ==========================================
  ! 约束A：电解铝厂 (可中断负荷 -> 电-热动态平衡)
  ! ==========================================
  T_cell[1] = 955 ! 初始 0 时刻槽温
  
  ! 离散化的一阶状态空间方程：T(t+1) = T(t) + [输入热量 - 散失热量] / 热容
  ! 常数 3600 用于将 MW(兆焦/秒) 转换为 小时级 的能量
  T_cell[2:25] = T_cell[1:24] + (P_Al[1:24]*eta_Al - (T_cell[1:24]-T_env)/R_th) * 3600 / C_cell

  ! ==========================================
  ! 约束B：碳化硅厂 (可削减负荷 -> 离散档位与设备保护)
  ! ==========================================
  ! 1. 同一时刻变压器必须且只能挂靠在一个档位上
  z_g1[1:24] + z_g2[1:24] + z_g3[1:24] + z_g4[1:24] = 1

  ! 2. 档位 0-1 变量与实际连续功率的严格映射
  P_Si[1:24] = z_g1[1:24]*P_gear1 + z_g2[1:24]*P_gear2 + z_g3[1:24]*P_gear3 + z_g4[1:24]*P_gear4

  ! 3. 爬坡约束，防止功率突变拉断电极
  P_Si[2:24] - P_Si[1:23] <= Ramp_max
  P_Si[1:23] - P_Si[2:24] <= Ramp_max

  ! ==========================================
  ! 约束C：钢铁厂 (可转移负荷 -> 生产批次与时序耦合)
  ! ==========================================
  ! 1. 每天只排产一炉 (APM方程内需手动展开累加)
  z_start[1]+z_start[2]+z_start[3]+z_start[4]+z_start[5]+z_start[6]+z_start[7]+z_start[8]+z_start[9]+z_start[10]+z_start[11]+z_start[12]+z_start[13]+z_start[14]+z_start[15]+z_start[16]+z_start[17]+z_start[18]+z_start[19]+z_start[20]+z_start[21]+z_start[22]+z_start[23]+z_start[24] = 1

  ! 2. 工序不可中断约束：一旦启动(z_start=1)，必须连续运行3个小时(z_work=1)
  z_work[1:22] >= z_start[1:22]
  z_work[2:23] >= z_start[1:22]
  z_work[3:24] >= z_start[1:22]

  ! 3. 状态与功率的映射
  P_Steel[1:24] = z_work[1:24] * P_steel_base

  ! ==========================================
  ! 约束D：系统功率平衡
  ! ==========================================
  ! 系统电源侧(风+光+购电) = 负荷侧(基础负荷+铝+硅+钢)
  P_wt + P_pv + P_buy[1:24] = Load_base + P_Al[1:24] + P_Si[1:24] + P_Steel[1:24]

  ! ==========================================
  ! 目标函数
  ! ==========================================
  minimize Total_Cost
End Equations
