! === 两阶段随机机组组合与高载能精细化调度模型 (SUC-DR) ===

! ---------------------------------------------------
! 1. 第一阶段决策变量 (0-1整数变量，所有场景共用)
! ---------------------------------------------------
Variables
  ! 火电机组启停状态
  u_G[1:24] >= 0, <= 1
  
  ! 钢铁厂：批次启动状态与加工状态 (日前排产，不可实时更改)
  z_start[1:24] >= 0, <= 1
  z_work[1:24] >= 0, <= 1
  
  ! 碳化硅厂：档位状态 (由于响应极快，设为第二阶段实时决策，因此分场景定义)
  z_g1_s1[1:24] >= 0, <= 1
  z_g2_s1[1:24] >= 0, <= 1
  z_g3_s1[1:24] >= 0, <= 1
  
  z_g1_s2[1:24] >= 0, <= 1
  z_g2_s2[1:24] >= 0, <= 1
  z_g3_s2[1:24] >= 0, <= 1
End Variables

! ---------------------------------------------------
! 2. 物理与系统参数设定
! ---------------------------------------------------
Parameters
  ! -- 场景概率 --
  pi_s1 = 0.7      ! 基础场景发生概率
  pi_s2 = 0.3      ! 极端场景发生概率
  
  ! -- 火电机组参数 --
  P_G_min = 60
  P_G_max = 300
  Ramp_G = 50      ! 爬坡率 (MW/h)
  Reserve_G = 30   ! 旋转备用容量 (MW) 对应论文公式(21)的 Delta_n
  Cost_fuel = 20   ! 燃料成本 ($/MWh)
  Cost_su = 100    ! 启动成本
  
  ! -- 物理参数 (电解铝 & 碳化硅 & 钢铁) --
  T_env = 25       ! 环境温度
  C_cell = 1200    ! 铝槽热容
  R_th = 0.08      ! 铝槽热阻
  eta_Al = 0.92    ! 电热效率
  P_gear1 = 0      ! 硅厂0档
  P_gear2 = 60     ! 硅厂1档
  P_gear3 = 100    ! 硅厂2档
  Ramp_Si = 40     ! 硅厂最大爬坡
  P_steel_base = 50 ! 钢厂单炉功率
  
  ! -- 惩罚成本 --
  Cost_curtail = 60 ! 弃风弃光惩罚 ($/MWh)

  ! -- 系统输入数据 (简化为常数，实际应为 24 维数组) --
  Load_base = 200
  ! 场景1：正常风光
  P_wt_s1 = 150
  P_pv_s1 = 100
  ! 场景2：极端无风光
  P_wt_s2 = 50
  P_pv_s2 = 20
End Parameters

! ---------------------------------------------------
! 3. 第二阶段连续变量 (分场景独立决策)
! ---------------------------------------------------
Variables
  ! 火电实际出力
  P_G_s1[1:24] >= 0, <= 300
  P_G_s2[1:24] >= 0, <= 300
  
  ! 电解铝实时状态 (安全域: 940~970℃)
  T_cell_s1[1:25] = 955, >= 940, <= 970 
  P_Al_s1[1:24] >= 0, <= 120
  T_cell_s2[1:25] = 955, >= 940, <= 970
  P_Al_s2[1:24] >= 0, <= 120

  ! 碳化硅实时功率
  P_Si_s1[1:24] >= 0, <= 100
  P_Si_s2[1:24] >= 0, <= 100

  ! 弃风弃光量
  Curt_wt_s1[1:24] >= 0
  Curt_wt_s2[1:24] >= 0
End Variables

! ---------------------------------------------------
! 4. 中间变量 (期望成本计算)
! ---------------------------------------------------
Intermediates
  ! 钢铁厂日前确定的功率 (所有场景相同)
  P_Steel[1:24] = z_work[1:24] * P_steel_base
  
  ! 场景1 运行成本 (燃料 + 弃风惩罚)
  cost_s1[0] = 0
  cost_s1[1:24] = cost_s1[0:23] + Cost_fuel*P_G_s1[1:24] + Cost_curtail*Curt_wt_s1[1:24]
  
  ! 场景2 运行成本
  cost_s2[0] = 0
  cost_s2[1:24] = cost_s2[0:23] + Cost_fuel*P_G_s2[1:24] + Cost_curtail*Curt_wt_s2[1:24]

  ! 机组启停成本估算 (简化)
  cost_su_total[0] = 0
  cost_su_total[1:24] = cost_su_total[0:23] + Cost_su * u_G[1:24] ! 此处严格应引入 z_on 变量，为防非线性暂简化

  ! 目标函数：总期望成本 (公式 9)
  Expected_Cost = pi_s1 * cost_s1[24] + pi_s2 * cost_s2[24] + cost_su_total[24]
End Intermediates

! ---------------------------------------------------
! 5. 约束方程
! ---------------------------------------------------
Equations
  ! ==========================================
  ! [共有约束] 钢铁厂日前排产 (连续生产)
  ! ==========================================
  z_start[1]+z_start[2]+z_start[3]+z_start[4]+z_start[5]+z_start[6]+z_start[7]+z_start[8]+z_start[9]+z_start[10]+z_start[11]+z_start[12]+z_start[13]+z_start[14]+z_start[15]+z_start[16]+z_start[17]+z_start[18]+z_start[19]+z_start[20]+z_start[21]+z_start[22]+z_start[23]+z_start[24] = 1
  z_work[1:22] >= z_start[1:22]
  z_work[2:23] >= z_start[1:22]
  z_work[3:24] >= z_start[1:22]

  ! ==========================================
  ! [耦合约束] SUC 场景切换耦合 (论文公式 21)
  ! ==========================================
  ! 极端场景的出力调整不能超过基础场景设定的旋转备用容量 Delta_n
  P_G_s2[1:24] - P_G_s1[1:24] <= Reserve_G
  P_G_s1[1:24] - P_G_s2[1:24] <= Reserve_G

  ! ==========================================
  ! [场景1约束] 基础场景 (S1)
  ! ==========================================
  ! 1. 火电上下限与基础场景爬坡 (论文公式 19, 20)
  P_G_s1[1:24] >= u_G[1:24] * P_G_min
  P_G_s1[1:24] <= u_G[1:24] * P_G_max
  P_G_s1[2:24] - P_G_s1[1:23] <= Ramp_G
  P_G_s1[1:23] - P_G_s1[2:24] <= Ramp_G

  ! 2. 电解铝热力学方程
  T_cell_s1[1] = 955
  T_cell_s1[2:25] = T_cell_s1[1:24] + (P_Al_s1[1:24]*eta_Al - (T_cell_s1[1:24]-T_env)/R_th) * 3600 / C_cell

  ! 3. 碳化硅档位方程
  z_g1_s1[1:24] + z_g2_s1[1:24] + z_g3_s1[1:24] = 1
  P_Si_s1[1:24] = z_g1_s1[1:24]*P_gear1 + z_g2_s1[1:24]*P_gear2 + z_g3_s1[1:24]*P_gear3
  P_Si_s1[2:24] - P_Si_s1[1:23] <= Ramp_Si
  P_Si_s1[1:23] - P_Si_s1[2:24] <= Ramp_Si

  ! 4. 系统功率平衡
  P_G_s1[1:24] + (P_wt_s1 - Curt_wt_s1[1:24]) + P_pv_s1 = Load_base + P_Al_s1[1:24] + P_Si_s1[1:24] + P_Steel[1:24]

  ! ==========================================
  ! [场景2约束] 极端场景 (S2)
  ! ==========================================
  ! 1. 火电上下限 (极端场景爬坡在公式21耦合中隐含限制，不单独列出)
  P_G_s2[1:24] >= u_G[1:24] * P_G_min
  P_G_s2[1:24] <= u_G[1:24] * P_G_max

  ! 2. 电解铝热力学 (极端场景下为了保电网，电解铝会自动调低功率，引发槽温下降)
  T_cell_s2[1] = 955
  T_cell_s2[2:25] = T_cell_s2[1:24] + (P_Al_s2[1:24]*eta_Al - (T_cell_s2[1:24]-T_env)/R_th) * 3600 / C_cell

  ! 3. 碳化硅档位
  z_g1_s2[1:24] + z_g2_s2[1:24] + z_g3_s2[1:24] = 1
  P_Si_s2[1:24] = z_g1_s2[1:24]*P_gear1 + z_g2_s2[1:24]*P_gear2 + z_g3_s2[1:24]*P_gear3
  P_Si_s2[2:24] - P_Si_s2[1:23] <= Ramp_Si
  P_Si_s2[1:23] - P_Si_s2[2:24] <= Ramp_Si

  ! 4. 系统功率平衡
  P_G_s2[1:24] + (P_wt_s2 - Curt_wt_s2[1:24]) + P_pv_s2 = Load_base + P_Al_s2[1:24] + P_Si_s2[1:24] + P_Steel[1:24]

  ! ==========================================
  ! 目标函数
  ! ==========================================
  minimize Expected_Cost
End Equations
